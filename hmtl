                    </div>
                    <div class="bg-harbor-navy text-harbor-teal p-4 rounded-xl font-mono text-xs overflow-x-auto">
                        <pre><code>const crypto = require('crypto');

function verifyHarborPayLink(amount, recipient, exp, signature) {
  const secret = process.env.HARBOR_HMAC_SECRET;
  const payload = `${amount}:${recipient}:${exp}`;
  
  const expectedSig = crypto
    .createHmac('sha256', secret)
    .update(payload)
    .digest('hex');

  // Anti-tamper & expiration validation
  const isSignatureValid = crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expectedSig));
  const isExpired = Date.now() > parseInt(exp);

  return isSignatureValid && !isExpired;
}</code></pre>
