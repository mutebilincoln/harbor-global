<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Harbor - Global Money Transfers & Secure Payment Links</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        harbor: {
                            navy: '#0b132b',
                            dark: '#1c2541',
                            teal: '#06d6a0',
                            tealHover: '#05b88a',
                            accent: '#3a86ff',
                            slate: '#334155',
                            lightBg: '#f8fafc'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #94a3b8;
            border-radius: 4px;
        }
        .animate-fade-in {
            animation: fadeIn 0.25s ease-out forwards;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-harbor-lightBg text-slate-800 font-sans min-h-screen flex flex-col justify-between selection:bg-harbor-teal selection:text-harbor-navy">

    <!-- TOP HEADER / NAV BAR -->
    <header class="bg-harbor-navy text-white sticky top-0 z-40 border-b border-slate-800 shadow-xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Brand Logo -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('transfer')">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-harbor-teal to-harbor-accent flex items-center justify-center font-extrabold text-harbor-navy text-xl shadow-lg shadow-harbor-teal/20">
                    <i class="fa-solid fa-anchor"></i>
                </div>
                <div>
                    <span class="text-xl font-black tracking-tight text-white">HARBOR</span>
                    <span class="hidden sm:inline-block text-[10px] uppercase font-bold tracking-widest text-harbor-teal bg-harbor-teal/10 px-2 py-0.5 rounded ml-2 border border-harbor-teal/20">Global Payments</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center space-x-1">
                <button onclick="switchTab('transfer')" id="nav-transfer" class="px-3.5 py-2 rounded-lg text-sm font-semibold text-harbor-teal bg-harbor-dark border border-harbor-teal/20 transition flex items-center gap-2">
                    <i class="fa-solid fa-paper-plane text-xs"></i>Send Money
                </button>
                <button onclick="switchTab('links')" id="nav-links" class="px-3.5 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-white hover:bg-harbor-dark/60 transition flex items-center gap-2">
                    <i class="fa-solid fa-link text-xs"></i>Harbor Pay Links
                </button>
                <button onclick="switchTab('history')" id="nav-history" class="px-3.5 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-white hover:bg-harbor-dark/60 transition flex items-center gap-2">
                    <i class="fa-solid fa-clock-rotate-left text-xs"></i>Transfers & Ledger
                </button>
                <button onclick="switchTab('security')" id="nav-security" class="px-3.5 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-white hover:bg-harbor-dark/60 transition flex items-center gap-2">
                    <i class="fa-solid fa-shield-halved text-xs"></i>Security & Anti-Bot
                </button>
                <button onclick="switchTab('developer')" id="nav-developer" class="px-3.5 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-white hover:bg-harbor-dark/60 transition flex items-center gap-2">
                    <i class="fa-solid fa-code text-xs"></i>API & Dev Setup
                </button>
            </nav>

            <!-- User Badge / Quick Controls -->
            <div class="flex items-center space-x-3">
                <div class="hidden sm:flex items-center space-x-2 text-xs bg-harbor-dark px-3 py-1.5 rounded-full border border-slate-700/60">
                    <span class="w-2 h-2 rounded-full bg-harbor-teal animate-pulse"></span>
                    <span class="text-slate-300 font-medium">Turnstile Active</span>
                </div>
                <div class="w-9 h-9 rounded-full bg-slate-700 flex items-center justify-center font-bold text-xs text-white border border-slate-600">
                    HB
                </div>
            </div>
        </div>

        <!-- Mobile Nav Scrollable Row -->
        <div class="md:hidden flex overflow-x-auto px-4 py-2 bg-harbor-dark border-t border-slate-800 text-xs space-x-2">
            <button onclick="switchTab('transfer')" class="px-3 py-1.5 rounded bg-slate-800 text-white whitespace-nowrap">Send</button>
            <button onclick="switchTab('links')" class="px-3 py-1.5 rounded bg-slate-800 text-white whitespace-nowrap">Pay Links</button>
            <button onclick="switchTab('history')" class="px-3 py-1.5 rounded bg-slate-800 text-white whitespace-nowrap">Ledger</button>
            <button onclick="switchTab('security')" class="px-3 py-1.5 rounded bg-slate-800 text-white whitespace-nowrap">Security</button>
            <button onclick="switchTab('developer')" class="px-3 py-1.5 rounded bg-slate-800 text-white whitespace-nowrap">API Guide</button>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full flex-grow">

        <!-- ==================== TAB 1: SEND MONEY WORKFLOW ==================== -->
        <div id="tab-transfer" class="block animate-fade-in">
            
            <!-- Progress Bar Tracker -->
            <div class="max-w-3xl mx-auto mb-8">
                <div class="flex justify-between items-center relative">
                    <div class="absolute top-1/2 left-0 right-0 h-1 bg-slate-200 -translate-y-1/2 z-0"></div>
                    <div id="progress-bar-fill" class="absolute top-1/2 left-0 h-1 bg-harbor-teal -translate-y-1/2 z-0 transition-all duration-300" style="width: 0%;"></div>

                    <div class="relative z-10 text-center">
                        <div id="step-btn-1" class="w-10 h-10 rounded-full bg-harbor-navy text-harbor-teal border-2 border-harbor-teal font-bold flex items-center justify-center mx-auto shadow-md transition">1</div>
                        <span class="text-xs font-semibold text-slate-800 mt-1.5 block">Calculator</span>
                    </div>

                    <div class="relative z-10 text-center">
                        <div id="step-btn-2" class="w-10 h-10 rounded-full bg-slate-200 text-slate-600 font-bold flex items-center justify-center mx-auto transition">2</div>
                        <span class="text-xs font-medium text-slate-500 mt-1.5 block">Recipient</span>
                    </div>

                    <div class="relative z-10 text-center">
                        <div id="step-btn-3" class="w-10 h-10 rounded-full bg-slate-200 text-slate-600 font-bold flex items-center justify-center mx-auto transition">3</div>
                        <span class="text-xs font-medium text-slate-500 mt-1.5 block">Payment</span>
                    </div>

                    <div class="relative z-10 text-center">
                        <div id="step-btn-4" class="w-10 h-10 rounded-full bg-slate-200 text-slate-600 font-bold flex items-center justify-center mx-auto transition">4</div>
                        <span class="text-xs font-medium text-slate-500 mt-1.5 block">Review</span>
                    </div>
                </div>
            </div>

            <!-- STEP 1: CALCULATOR & SPEED TIERING -->
            <div id="step-1" class="max-w-xl mx-auto bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden">
                <div class="bg-harbor-navy px-6 py-4 text-white flex justify-between items-center border-b border-slate-800">
                    <div>
                        <h2 class="text-lg font-bold">Harbor Exchange Engine</h2>
                        <p class="text-xs text-slate-400">Guaranteed rate lock • Transparent fees</p>
                    </div>
                    <span class="px-2.5 py-1 text-[11px] bg-harbor-teal/10 text-harbor-teal border border-harbor-teal/30 rounded-full font-mono font-semibold">Live Forex API</span>
                </div>

                <div class="p-6 space-y-5">
                    <!-- Send Amount -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">You Send</label>
                        <div class="relative flex rounded-xl border border-slate-300 focus-within:ring-2 focus-within:ring-harbor-teal focus-within:border-harbor-teal bg-white">
                            <input type="number" id="send-amount" value="500" min="10" max="10000" oninput="calculateExchange()" class="w-full px-4 py-3 text-2xl font-black text-slate-900 rounded-l-xl focus:outline-none">
                            <select id="send-currency" onchange="calculateExchange()" class="bg-slate-100 border-l border-slate-300 px-4 py-3 font-bold text-slate-700 rounded-r-xl focus:outline-none cursor-pointer">
                                <option value="USD">USD ($)</option>
                                <option value="EUR">EUR (€)</option>
                                <option value="GBP">GBP (£)</option>
                                <option value="CAD">CAD ($)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Speed & Method Tiers -->
                    <div class="grid grid-cols-2 gap-3">
                        <label onclick="updateSpeedTier('express')" id="tier-express" class="border-2 border-harbor-teal bg-harbor-teal/10 p-3 rounded-xl cursor-pointer transition">
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-bold text-xs uppercase text-harbor-navy">Express</span>
                                <span class="text-[10px] bg-harbor-teal text-harbor-navy px-1.5 py-0.5 font-extrabold rounded">Fastest</span>
                            </div>
                            <p class="text-xs text-slate-600 font-medium">Minutes • Card / MoMo</p>
                            <p class="text-xs font-bold text-slate-800 mt-1">$2.99 Fee</p>
                        </label>

                        <label onclick="updateSpeedTier('economy')" id="tier-economy" class="border-2 border-slate-200 p-3 rounded-xl cursor-pointer hover:border-slate-300 transition">
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-bold text-xs uppercase text-slate-700">Economy</span>
                                <span class="text-[10px] bg-slate-200 text-slate-700 px-1.5 py-0.5 font-bold rounded">Low Cost</span>
                            </div>
                            <p class="text-xs text-slate-500 font-medium">1-3 Days • Bank Account</p>
                            <p class="text-xs font-bold text-emerald-600 mt-1">$0.00 Fee</p>
                        </label>
                    </div>

                    <!-- Transparent Pricing Breakdown -->
                    <div class="bg-slate-50 p-4 rounded-xl space-y-2 text-sm border border-slate-200">
                        <div class="flex justify-between text-slate-600 text-xs">
                            <span>Transfer Fee:</span>
                            <span id="fee-text" class="font-bold text-slate-800">$2.99 USD</span>
                        </div>
                        <div class="flex justify-between text-slate-600 text-xs">
                            <span>Guaranteed Exchange Rate:</span>
                            <span id="rate-text" class="font-bold text-harbor-teal">1 USD = 15.20 GHS</span>
                        </div>
                        <div class="flex justify-between text-slate-600 text-xs">
                            <span>Amount Converted:</span>
                            <span id="convert-amount-text" class="font-semibold text-slate-800">$497.01 USD</span>
                        </div>
                        <div class="pt-2 border-t border-slate-200 flex justify-between items-center text-slate-900 font-black">
                            <span class="text-xs uppercase">Total You Pay:</span>
                            <span id="total-pay-text" class="text-lg text-harbor-navy">$500.00 USD</span>
                        </div>
                    </div>

                    <!-- Receive Amount -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Recipient Receives</label>
                        <div class="relative flex rounded-xl border border-slate-300 focus-within:ring-2 focus-within:ring-harbor-teal bg-white">
                            <input type="number" id="receive-amount" readonly class="w-full px-4 py-3 text-2xl font-black text-harbor-teal bg-slate-50/50 rounded-l-xl focus:outline-none">
                            <select id="receive-currency" onchange="calculateExchange()" class="bg-slate-100 border-l border-slate-300 px-4 py-3 font-bold text-slate-700 rounded-r-xl focus:outline-none cursor-pointer">
                                <option value="GHS">GHS (Ghana)</option>
                                <option value="NGN">NGN (Nigeria)</option>
                                <option value="KES">KES (Kenya)</option>
                                <option value="ZAR">ZAR (South Africa)</option>
                                <option value="PHP">PHP (Philippines)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Payout Delivery Method -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Payout Method</label>
                        <div class="grid grid-cols-2 gap-3">
                            <label id="payout-opt-momo" onclick="updatePayoutType('momo')" class="border-2 border-harbor-teal bg-harbor-teal/5 p-3 rounded-xl cursor-pointer flex items-center space-x-3 text-sm font-semibold">
                                <input type="radio" name="payoutMethod" value="Mobile Money" checked class="accent-harbor-teal">
                                <div>
                                    <div class="text-xs font-bold text-slate-900"><i class="fa-solid fa-mobile-screen text-harbor-teal mr-1"></i> Mobile Money</div>
                                    <div class="text-[10px] text-slate-500">MTN, M-Pesa, Telecel</div>
                                </div>
                            </label>

                            <label id="payout-opt-bank" onclick="updatePayoutType('bank')" class="border-2 border-slate-200 p-3 rounded-xl cursor-pointer flex items-center space-x-3 text-sm font-semibold hover:bg-slate-50">
                                <input type="radio" name="payoutMethod" value="Bank Deposit" class="accent-harbor-teal">
                                <div>
                                    <div class="text-xs font-bold text-slate-900"><i class="fa-solid fa-building-columns text-slate-500 mr-1"></i> Bank Account</div>
                                    <div class="text-[10px] text-slate-500">Direct Deposit</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <button onclick="goToStep(2)" class="w-full py-3.5 bg-harbor-navy hover:bg-harbor-dark text-harbor-teal font-extrabold rounded-xl shadow-lg transition flex items-center justify-center gap-2">
                        <span>Continue to Recipient Info</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                </div>
            </div>

            <!-- STEP 2: RECIPIENT INFORMATION -->
            <div id="step-2" class="max-w-xl mx-auto bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden hidden">
                <div class="bg-harbor-navy px-6 py-4 text-white flex justify-between items-center">
                    <div>
                        <h2 class="text-lg font-bold">Recipient Details</h2>
                        <p class="text-xs text-slate-400">Where should Harbor deliver the funds?</p>
                    </div>
                    <button onclick="goToStep(1)" class="text-xs text-harbor-teal hover:underline font-semibold">Back to Rate</button>
                </div>

                <form id="recipient-form" onsubmit="handleRecipientSubmit(event)" class="p-6 space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">First Name *</label>
                            <input type="text" id="rec-first-name" required placeholder="Kofi" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-harbor-teal focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Last Name *</label>
                            <input type="text" id="rec-last-name" required placeholder="Mensah" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-harbor-teal focus:outline-none">
                        </div>
                    </div>

                    <div>
                        <label id="provider-label" class="block text-xs font-bold text-slate-700 mb-1">Mobile Network Provider *</label>
                        <select id="rec-provider" required class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-harbor-teal focus:outline-none bg-white font-medium">
                            <!-- JS Populated -->
                        </select>
                    </div>

                    <div>
                        <label id="account-label" class="block text-xs font-bold text-slate-700 mb-1">Mobile Money Number *</label>
                        <input type="text" id="rec-account-num" required placeholder="+233 24 000 0000" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-harbor-teal focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Transfer Purpose</label>
                        <select id="rec-reason" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-harbor-teal focus:outline-none bg-white">
                            <option value="Family Support">Family Maintenance & Support</option>
                            <option value="Education / Tuition">Tuition & Education</option>
                            <option value="Business Services">Business Invoice Settlement</option>
                            <option value="Property / Savings">Property or Personal Savings</option>
                        </select>
                    </div>

                    <div class="pt-4 flex gap-3">
                        <button type="button" onclick="goToStep(1)" class="w-1/3 py-3 border border-slate-300 text-slate-700 font-bold rounded-xl hover:bg-slate-50 transition">Back</button>
                        <button type="submit" class="w-2/3 py-3 bg-harbor-navy hover:bg-harbor-dark text-harbor-teal font-extrabold rounded-xl shadow-lg transition">Payment Method</button>
                    </div>
                </form>
            </div>

            <!-- STEP 3: PAYMENT METHOD -->
            <div id="step-3" class="max-w-xl mx-auto bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden hidden">
                <div class="bg-harbor-navy px-6 py-4 text-white">
                    <h2 class="text-lg font-bold">Funding Method</h2>
                    <p class="text-xs text-slate-400">Select how you wish to pay Harbor</p>
                </div>

                <div class="p-6 space-y-4">
                    <div class="space-y-3">
                        <label class="border-2 border-harbor-teal bg-harbor-teal/10 p-4 rounded-xl cursor-pointer flex items-center justify-between">
                            <div class="flex items-center space-x-3">
                                <input type="radio" name="payMethod" value="Debit / Credit Card" checked class="accent-harbor-teal">
                                <div>
                                    <p class="font-bold text-slate-900 text-sm">Debit or Credit Card</p>
                                    <p class="text-xs text-slate-500">Instant processing via Stripe Gateway</p>
                                </div>
                            </div>
                            <div class="flex space-x-1 text-slate-600 text-lg">
                                <i class="fa-brands fa-cc-visa text-blue-600"></i>
                                <i class="fa-brands fa-cc-mastercard text-red-500"></i>
                            </div>
                        </label>

                        <label class="border-2 border-slate-200 p-4 rounded-xl cursor-pointer flex items-center justify-between hover:border-slate-300">
                            <div class="flex items-center space-x-3">
                                <input type="radio" name="payMethod" value="Plaid Bank Transfer" class="accent-harbor-teal">
                                <div>
                                    <p class="font-bold text-slate-900 text-sm">Direct Bank Account (ACH/Plaid)</p>
                                    <p class="text-xs text-slate-500">Connect US/EU bank directly</p>
                                </div>
                            </div>
                            <i class="fa-solid fa-university text-slate-400"></i>
                        </label>
                    </div>

                    <!-- Simulated Card Panel -->
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3 text-xs">
                        <p class="font-bold uppercase text-slate-500">Demo Payment Credentials</p>
                        <input type="text" value="John Harbor Doe" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none">
                        <input type="text" value="4242 •••• •••• 4242" class="w-full px-3 py-2 border border-slate-300 rounded-lg font-mono focus:outline-none">
                        <div class="grid grid-cols-2 gap-3">
                            <input type="text" value="12/28" class="px-3 py-2 border border-slate-300 rounded-lg font-mono focus:outline-none">
                            <input type="password" value="123" class="px-3 py-2 border border-slate-300 rounded-lg font-mono focus:outline-none">
                        </div>
                    </div>

                    <div class="pt-2 flex gap-3">
                        <button type="button" onclick="goToStep(2)" class="w-1/3 py-3 border border-slate-300 text-slate-700 font-bold rounded-xl hover:bg-slate-50 transition">Back</button>
                        <button onclick="goToStep(4)" class="w-2/3 py-3 bg-harbor-navy hover:bg-harbor-dark text-harbor-teal font-extrabold rounded-xl shadow-lg transition">Review Transfer</button>
                    </div>
                </div>
            </div>

            <!-- STEP 4: REVIEW & SUBMIT -->
            <div id="step-4" class="max-w-xl mx-auto bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden hidden">
                <div class="bg-harbor-navy px-6 py-4 text-white">
                    <h2 class="text-lg font-bold">Review Transfer Order</h2>
                    <p class="text-xs text-slate-400">Verify details before submitting to payment rails</p>
                </div>

                <div class="p-6 space-y-5">
                    <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 space-y-3 text-xs">
                        <div class="flex justify-between pb-2 border-b border-slate-200">
                            <span class="text-slate-500">Transfer Amount:</span>
                            <span id="summary-send-amount" class="font-bold text-slate-800">$500.00 USD</span>
                        </div>
                        <div class="flex justify-between pb-2 border-b border-slate-200">
                            <span class="text-slate-500">Locked Rate:</span>
                            <span id="summary-rate" class="font-bold text-harbor-teal">1 USD = 15.20 GHS</span>
                        </div>
                        <div class="flex justify-between pb-2 border-b border-slate-200">
                            <span class="text-slate-500">Recipient Payout:</span>
                            <span id="summary-receive-amount" class="font-extrabold text-harbor-navy text-base">7,554.55 GHS</span>
                        </div>
                        <div class="flex justify-between pb-2 border-b border-slate-200">
                            <span class="text-slate-500">Recipient Name:</span>
                            <span id="summary-rec-name" class="font-bold text-slate-800">Kofi Mensah</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Delivery Channel:</span>
                            <span id="summary-rec-details" class="font-bold text-slate-800">MTN Mobile Money</span>
                        </div>
                    </div>

                    <!-- Security Audit Badge -->
                    <div class="flex items-center space-x-3 p-3 bg-harbor-teal/10 rounded-xl border border-harbor-teal/30 text-xs text-slate-800">
                        <i class="fa-solid fa-shield-check text-harbor-teal text-xl"></i>
                        <span>Protected by Harbor Anti-Bot Engine & HMAC Link Signature Protocol.</span>
                    </div>

