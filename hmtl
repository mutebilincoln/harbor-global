            const expiryMins = parseInt(document.getElementById('link-expiry').value);
            
            generatedExpiry = Date.now() + (expiryMins * 60 * 1000);
            
            // Mock SHA-256 HMAC Signature
            const rawPayload = `${amount}:${note}:${generatedExpiry}:HARBOR_SECRET_KEY`;
            generatedSignature = 'sig_' + Array.from(rawPayload).reduce((acc, char) => (acc * 31 + char.charCodeAt(0)) % 0xFFFFFFFF, 17).toString(16) + '9a8b7c';

            generatedUrl = `https://harbor.com/pay?amt=${amount}&note=${note}&exp=${generatedExpiry}&sig=${generatedSignature}`;

            document.getElementById('signed-url-display').innerText = generatedUrl;
            document.getElementById('link-exp-display').innerText = new Date(generatedExpiry).toLocaleTimeString();
